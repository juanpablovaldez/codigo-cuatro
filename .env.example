# ============================================================
# .env.example — Variables de entorno del proyecto
# Copiar este archivo como .env y completar los valores reales
# NUNCA commitear el archivo .env
# ============================================================

# --- Gateway ---
GATEWAY_PORT=3000

# --- Catalog Service ---
CATALOG_SERVICE_HOST=localhost
CATALOG_SERVICE_PORT=3003

# --- Order Service ---
ORDER_SERVICE_HOST=localhost
ORDER_SERVICE_PORT=3005

# --- RabbitMQ (para fases event-driven futuras) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
