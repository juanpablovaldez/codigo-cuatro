# ============================================================
# .env.example — Variables de entorno del proyecto
# Copiar este archivo como .env y completar los valores reales
# NUNCA commitear el archivo .env
# ============================================================

# --- Gateway ---
GATEWAY_PORT=3000

# --- Products Service ---
PRODUCTS_SERVICE_HOST=localhost
PRODUCTS_SERVICE_PORT=3003

# --- Orders Service ---
ORDERS_SERVICE_HOST=localhost
ORDERS_SERVICE_PORT=3005

# --- RabbitMQ (para fases event-driven futuras) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
